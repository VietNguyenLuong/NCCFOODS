extends layoutQuanTri

block content
  .page-wrapper
    // ===== HEADER =====
    .page-header
      h1 QUẢN LÝ NHÓM SẢN PHẨM
      .breadcrumb
        a(href="#") Quản trị hệ thống
        span /
        span Quản lý nhóm sản phẩm

    // ===== CARD =====
    .card
      .card-header
        h3 Danh sách nhóm sản phẩm
        button.btn(onclick=`addproducts()`).btn-primary Thêm mới nhóm sản phẩm

      .card-tools
        .show-entries
          span Show
          select
            option 10
            option 25
            option 50
          span entries

        .search-box
          label Search:
          input#searchName(type="text" placeholder="" onchange="loadData()")

      // ===== TABLE =====
      table.product-table
        thead
          tr
            th Tên nhóm
            th Trạng thái
            th Thao tác
        tbody
            each item in categorys
                tr
                    td=item.ten_nhom
                    td
                      label.switch
                          input(type="checkbox" checked onchange=`toggleStatus('${item._id}')`)
                          span.slider
                    td
                      a(href=`/nhomsanpham/getbyid/${item._id}`).btn-icon.edit ✎
                      a(onclick=`deleteSP('${item._id}')`).btn-icon.delete 🗑

    // ===== PAGINATION =====
    .pagination-wrapper
      .pagination-info
        | Showing #{showingStart} to #{showingEnd} of #{totalcategorys} entries

      ul.pagination
        if prevPage
          li.page-item.active
            a.page-link(href="#") Previous
        each item in pages
          li.page-item(class={ active: item.isActive })
            a.page-link(href=`?page=${item.num}&name=${keyword}`)= item.num
        if nextPage
          li.page-item
            a.page-link(href="#") Next          
  // Modal thêm sản phẩm
  .modal.fade#addActionModal(tabindex="-1" aria-labelledby="addActionModalLabel" aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content

        // Header
        .modal-header
          h5#addActionModalLabel.modal-title Thêm mới sản phẩm
          button.btn-close(
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
          )

        // Body
        .modal-body
          form#addCategoryForm(
            action="/nhomsanpham/create"
            method="POST"
          )
            .row.g-3

              .col-md-12
                label.form-label(for="ten_nhom") Tên sản phẩm
                input.form-control(
                  type="text"
                  id="ten_nhom"
                  name="ten_nhom"
                  required
                )

        // Footer
        .modal-footer
          button.btn.btn-secondary(
            type="button"
            onclick=`CloseModal()`
          ) Đóng
          button.btn.btn-primary(
            type="submit"
            form="addCategoryForm"
          ) Lưu

  script(src="/javascripts/nhomsanpham.js")  