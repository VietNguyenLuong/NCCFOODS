extends layoutQuanTri

block content
  .page-wrapper
    // ===== HEADER =====
    .page-header
      h1 QUẢN LÝ TÀI KHOẢN
      .breadcrumb
        a(href="#") Quản trị hệ thống
        span /
        span Quản lý tài khoản

    // ===== CARD =====
    .card
      .card-header
        h3 Danh sách tài khoản
        button.btn(onclick=`addproducts()`).btn-primary Thêm mới 

      .card-tools
        .show-entries
          span Show
          select
            option 10
            option 25
            option 50
          span entries

        .search-box
          label Search:
          input#searchName(type="text" placeholder="" onchange="loadData()")

      // ===== TABLE =====
      table.product-table
        thead
          tr
            th Tên nhóm
            th Trạng thái
            th Thao tác
        tbody
            each item in data
                tr
                    td=item.username
                    td
                      label.switch
                          input(type="checkbox" checked=item.isActive onchange=`toggleStatus('${item._id}')`)
                          span.slider
                    td
                      a(href=`/taikhoan/getbyidQT/${item._id}`).btn-icon.edit ✎
                      a(onclick=`deleteSP('${item._id}')`).btn-icon.delete 🗑

    // ===== PAGINATION =====
    .pagination-wrapper
      .pagination-info
        | Showing #{showingStart} to #{showingEnd} of #{total} entries

      ul.pagination
        if prevPage
          li.page-item.active
            a.page-link(href="#") Previous
        each item in pages
          li.page-item(class={ active: item.isActive })
            a.page-link(href=`?page=${item.num}&name=${keyword}`)= item.num
        if nextPage
          li.page-item
            a.page-link(href="#") Next          
  // Modal thêm sản phẩm
  .modal.fade#addActionModal(tabindex="-1" aria-labelledby="addActionModalLabel" aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content

        // Header
        .modal-header
          h5#addActionModalLabel.modal-title Thêm mới tài khoản
          button.btn-close(
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
            onclick="CloseModal()"
          )

        // Body
        .modal-body
          form#addCategoryForm(
            action="/taikhoan/create"
            method="POST"
          )
            .row.g-3
              .col-md-6
                label.form-label(for="username") Tài khoản
                input.form-control(
                  type="text"
                  id="username"
                  name="username"
                  required
                )

              .col-md-6
                label.form-label(for="password") Mật khẩu
                input.form-control(
                  type="password"
                  id="password"
                  name="password"
                  required
                )

            .row.g-3.mt-2
              .col-md-6
                label.form-label(for="phone") Số điện thoại
                input.form-control(
                  type="text"
                  id="phone"
                  name="phone"
                  required
                )

              .col-md-6
                label.form-label(for="address") Địa chỉ
                input.form-control(
                  type="text"
                  id="address"
                  name="address"
                  required
                )

            .row.g-3.mt-2
              .col-md-6
                label.form-label(for="role") Phân quyền
                select.form-select(
                  id="role"
                  name="role"
                  required
                )
                  option(value="" disabled selected) -- Chọn phân quyền --
                  option(value="admin") admin
                  option(value="checkbill") checkbill
                  option(value="dongdon") dongdon

        // Footer
        .modal-footer
          button.btn.btn-secondary(
            type="button"
            onclick="CloseModal()"
          ) Đóng
          button.btn.btn-primary(
            type="submit"
            form="addCategoryForm"
          ) Lưu

  script(src="/javascripts/taikhoanQuantri.js")  