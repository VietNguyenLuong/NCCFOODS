extends layoutQuanTri

block content
  .page-wrapper
    // ===== HEADER =====
    .page-header
      h1 SỬA SẢN PHẨM
      .breadcrumb
        a(href="/admin") Quản trị
        span /
        a(href="/sanpham") Sản phẩm
        span /
        span Sửa

    // ===== CARD =====
    .card
      .card-header
        h3 Thông tin sản phẩm

      .card-body
        form(
          action="/sanpham/update"
          method="POST"
          enctype="multipart/form-data"
        )
          input(type="hidden" name="_id" value=product._id)

          .row.g-3
            // ===== TÊN =====
            .col-md-12
              label.form-label(for="name") Tên sản phẩm
              input.form-control(
                type="text"
                name="name"
                value=product.name
                required
              )

            // ===== STOCK =====
            .col-md-6
              label.form-label(for="stock") Số lượng trong kho
              input.form-control(
                type="number"
                name="stock"
                value=product.stock
                required
              )

            // ===== CATEGORY =====
            .col-md-6
              label.form-label Nhóm sản phẩm
              select.form-control(name="category_id" required)
                each cate in category
                  option(
                    value=cate._id
                    selected=(String(cate._id) === String(product.category_id))
                  )= cate.ten_nhom

            // ===== PRICE =====
            .col-md-6
              label.form-label Giá
              input.form-control(
                type="text"
                name="price"
                value=product.price
                required
              )

            // ===== CHECKBOX =====
            .col-md-6.checkbox-row
              label.form-label Bao thecbe
              input(
                type="checkbox"
                name="is_btb"
                checked=product.is_btb
              )

            .col-md-6.checkbox-row
              label.form-label Đơn riêng
              input(
                type="checkbox"
                name="is_general"
                checked=product.is_general
              )

            // ===== IMAGE =====
            .col-md-12
              label.form-label Ảnh sản phẩm
              input.form-control(
                type="file"
                name="image_url"
                accept="image/*"
                onchange="previewImage(event)"
              )

              if product.image_url
                img(
                  src=product.image_url
                  style="margin-top:10px; max-height:200px;"
                )

              img#preview(
                style="margin-top:10px; max-height:200px;"
              )

            // ===== DESCRIPTION =====
            .col-12
              label.form-label Mô tả
              textarea.form-control(
                name="description"
                rows="3"
              )= product.description

          // ===== ACTION =====
          .form-actions.mt-4
            button.btn.btn-primary(type="submit") Cập nhật
            a.btn.btn-secondary(href="/sanpham/getall") Quay lại
  script(src="/javascripts/chitietsanpham.js")  